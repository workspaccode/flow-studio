{
  "name": "flow-studio",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "start": "python3 server.py",
    "build:legacy": "python3 src/build.py",
    "test": "npm run build && npm run test:unit && npm run test:e2e",
    "test:unit": "python3 -m unittest discover -s tests -v",
    "test:e2e": "node --test tests/react-studio.test.mjs"
  },
  "dependencies": {
    "lottie-web": "^5.13.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "playwright": "^1.63.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}
